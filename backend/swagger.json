  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "UsuarioEntrada": {
        "type": "object",
        "required": [
          "nome",
          "email",
          "senha"
        ],
        "properties": {
          "nome": {
            "type": "string",
            "example": "Carlos Souza",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "example": "carlos@exemplo.com"
          },
          "foto_perfil": {
            "type": "string",
            "example": "/uploads/avatar.png",
            "nullable": true
          },
          "biografia": {
            "type": "string",
            "example": "Gosto de RPG.",
            "nullable": true
          },
          "senha": {
            "type": "string",
            "minLength": 1,
            "writeOnly": true,
            "example": "SenhaDeTeste123!"
          }
        }
      },
      "GeneroEntrada": {
        "type": "object",
        "required": [
          "nome"
        ],
        "properties": {
          "nome": {
            "type": "string",
            "example": "RPG",
            "minLength": 1
          },
          "descricao": {
            "type": "string",
            "example": "Jogos de interpretação de personagens.",
            "nullable": true
          }
        }
      },
      "JogoEntrada": {
        "type": "object",
        "required": [
          "titulo",
          "id_administrador"
        ],
        "properties": {
          "titulo": {
            "type": "string",
            "example": "Jogo Exemplo A",
            "minLength": 1
          },
          "descricao": {
            "type": "string",
            "example": "Descrição do jogo.",
            "nullable": true
          },
          "data_lancamento": {
            "type": "string",
            "format": "date",
            "example": "2020-05-10",
            "nullable": true
          },
          "desenvolvedora": {
            "type": "string",
            "example": "Estúdio X",
            "nullable": true
          },
          "capa": {
            "type": "string",
            "example": "/uploads/capa.png",
            "nullable": true
          },
          "id_administrador": {
            "type": "integer",
            "example": 1,
            "minimum": 1
          },
          "generos": {
            "type": "array",
            "items": {
              "type": "integer",
              "description": "Identificador de gênero.",
              "minimum": 1
            },
            "example": [
              1,
              2
            ]
          }
        }
      },
      "AvaliacaoEntrada": {
        "type": "object",
        "required": [
          "id_usuario",
          "id_jogo",
          "nota"
        ],
        "properties": {
          "id_usuario": {
            "type": "integer",
            "example": 2,
            "minimum": 1
          },
          "id_jogo": {
            "type": "integer",
            "example": 1,
            "minimum": 1
          },
          "nota": {
            "type": "integer",
            "example": 5,
            "minimum": 1,
            "maximum": 5
          },
          "comentario": {
            "type": "string",
            "example": "Muito bom!",
            "nullable": true
          }
        }
      },
      "BibliotecaEntrada": {
        "type": "object",
        "required": [
          "id_jogador"
        ],
        "properties": {
          "id_jogador": {
            "type": "integer",
            "example": 2,
            "minimum": 1
          },
          "descricao": {
            "type": "string",
            "example": "Minha coleção",
            "nullable": true
          },
          "privacidade": {
            "type": "string",
            "example": "PUBLICA",
            "enum": [
              "PUBLICA",
              "PRIVADA"
            ]
          }
        }
      },
      "UsuarioAtualizacao": {
        "type": "object",
        "required": [
          "nome",
          "email"
        ],
        "properties": {
          "nome": {
            "type": "string",
            "example": "Carlos Souza",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "example": "carlos@exemplo.com"
          },
          "foto_perfil": {
            "type": "string",
            "example": "/uploads/avatar.png",
            "nullable": true
          },
          "biografia": {
            "type": "string",
            "example": "Gosto de RPG.",
            "nullable": true
          },
          "senha": {
            "type": "string",
            "minLength": 1,
            "writeOnly": true,
            "example": "SenhaDeTeste123!"
          }
        }
      },
      "CredenciaisLogin": {
        "type": "object",
        "required": [
          "email",
          "senha"
        ],
