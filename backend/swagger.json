  "info": {
    "title": "BraryGame - API",
    "version": "1.0.0",
    "description": "Rotas do projeto BraryGame. Use POST /auth/login para gerar um token; GET /auth/me exige autenticação."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
